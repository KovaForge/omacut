#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build/tests"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "qmake6 or qmake is required to test omacut." >&2
  exit 1
fi

for suite in backend_tests uploader_tests provider_tests; do
  mkdir -p "$BUILD_DIR/${suite%_tests}"
  (
    cd "$BUILD_DIR/${suite%_tests}"
    "$QMAKE" "$ROOT/tests/$suite.pro"
    make
    "./$suite"
  )
done
